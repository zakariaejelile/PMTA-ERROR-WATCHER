{
  "manifest_version": 3,
  "name": "PMTA Error Watcher",
  "version": "2.2.1",
  "description": "Scans your multi-server PowerMTA panel (directly from its URL, or from an open tab) and lists which servers/IPs have sending errors.",
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "offscreen",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "PMTA Error Watcher"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "run_at": "document_idle",
      "js": [
        "parser.js",
        "content.js"
      ]
    }
  ]
}